# Copia este archivo a ".env" y completa los valores. NUNCA subas ".env" a GitHub.
PORT=4000
NODE_ENV=development

# Cadena de conexión de MongoDB Atlas (incluye el nombre de la base: crm_database)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@TU-CLUSTER.xxxxx.mongodb.net/crm_database?retryWrites=true&w=majority

# Secreto para firmar los JWT (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos por CORS (separados por coma)
CLIENT_URL=http://localhost:5173

# Solo para pruebas automáticas (base DESECHABLE; el nombre debe contener "test")
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/crm_test
